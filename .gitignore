# -- Node ----------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -- Environment – NEVER commit real secrets -----------------------------------
# Catch .env files at root and in every workspace
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
shared/.env
shared/.env.*
tests/.env
tests/.env.*
# .env.example files are safe to commit (placeholders only)
!.env.example
!frontend/.env.example
!backend/.env.example

# -- TypeScript build outputs --------------------------------------------------
dist/
build/
*.tsbuildinfo
.tsbuild/

# -- Vite ----------------------------------------------------------------------
frontend/dist/
frontend/.vite/

# -- AWS SAM / CloudFormation --------------------------------------------------
.aws-sam/
samconfig.toml
packaged.yaml
infra/.aws-sam/

# -- AWS credentials – NEVER commit -------------------------------------------
.aws/
credentials
aws-exports.js

# -- Test coverage -------------------------------------------------------------
coverage/
.nyc_output/
tests/coverage/

# -- Logs ----------------------------------------------------------------------
*.log
logs/

# -- Netlify -------------------------------------------------------------------
.netlify/

# -- OS / IDE ------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo
