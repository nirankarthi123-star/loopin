# ─────────────────────────────────────────────────────────────────────────────
# LoopIn – Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
# 1. FRONTEND ENVIRONMENT VARIABLES (Configured on Netlify or frontend/.env.local)
# ═════════════════════════════════════════════════════════════════════════════

VITE_APP_NAME=LoopIn
VITE_APP_TAGLINE="Need it? Loop it."

# Runtime Mode:
# - "aws": Calls the deployed AWS Lambda backend via VITE_API_BASE_URL.
# - "demo": Runs entirely offline in the browser using pre-seeded student demo data.
VITE_APP_MODE=demo

# Backend API Base URL:
# - In local development: http://localhost:3001
# - In production on Netlify: Set to the "ApiFunctionUrl" SAM deployment output
#   Example: https://abcdef123456789.lambda-url.us-east-1.on.aws/
VITE_API_BASE_URL=http://localhost:3001

# Vite local dev server port
VITE_DEV_PORT=5173

# ═════════════════════════════════════════════════════════════════════════════
# 2. BACKEND ENVIRONMENT VARIABLES (Injected automatically by AWS SAM / Lambda)
# (Used locally in backend/.env.local when running devServer against real AWS)
# ═════════════════════════════════════════════════════════════════════════════

# AWS Region for DynamoDB, EventBridge Scheduler, and SNS
AWS_REGION=us-east-1

# Persistence Driver:
# - "dynamodb": Persists to Amazon DynamoDB (or DynamoDB Local)
# - "memory": In-memory persistence for offline development & tests
STORAGE_DRIVER=dynamodb

# 1. Amazon DynamoDB Table
DYNAMODB_TABLE_NAME=loopin-dev
# Optional: Set endpoint when running against DynamoDB Local
# DYNAMODB_ENDPOINT=http://localhost:8000

# 2. Amazon SNS Topic for return notifications & loan alerts
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:loopin-notifications-dev

# 3. Amazon EventBridge Scheduler
REMINDER_SCHEDULE_GROUP=loopin-reminders-dev
REMINDER_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:loopin-reminders-dev
SCHEDULER_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/loopin-scheduler-exec-role-dev

# CORS Allowed Origin:
# Set to your Netlify site URL in production (e.g. https://loopin-campus.netlify.app)
# or http://localhost:5173 during local frontend testing. Never use wildcard in production.
ALLOWED_ORIGIN=https://loopin-campus.netlify.app

# Simulation Mode:
# - "false": Delivers real AWS EventBridge schedules and publishes real SNS messages.
# - "true": Simulates scheduler and notifications locally without AWS cloud calls.
SIMULATION_MODE=false

# 4. Cryptographic Authentication & Token Signing Secret:
# Secret key used by the Lambda backend to sign and verify session JWTs.
# Must be configured as a deployment parameter in SAM or environment variable.
# NEVER expose this secret to the frontend.
JWT_SECRET=replace-with-a-secure-random-32-char-string-in-production

